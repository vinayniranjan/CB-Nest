APP_NAME="Mock HRMS API"
# dev | prod  (prod refuses to start with a weak JWT_SECRET_KEY)
ENVIRONMENT=dev
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite+aiosqlite:///./storage/hrms.db
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
POLICY_UPLOAD_DIR=./storage/hr-policies
PROFILE_PHOTO_UPLOAD_DIR=./storage/profile-photos
EMPLOYEE_DOCUMENT_UPLOAD_DIR=./storage/employee-documents

# ---- AI Copilot ----
# Optional. Without a key the copilot uses its deterministic rule-based engines.
ANTHROPIC_API_KEY=
AI_LLM_ENABLED=true
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_LLM_TIMEOUT_SECONDS=30
# Server-side refusal fallback (beta) for Claude requests
AI_REFUSAL_FALLBACK=true
# How the action agent reaches this API (same container by default)
AI_INTERNAL_API_BASE_URL=http://127.0.0.1:8000
AI_SQL_MAX_ROWS=100
AI_SQL_TIMEOUT_SECONDS=5
# hashing (default, no downloads) | fastembed (pip install fastembed)
AI_EMBEDDING_BACKEND=hashing
AI_RAG_TOP_K=4
AI_RAG_MIN_SCORE=0.05
AI_RATE_LIMIT_PER_MINUTE=30
AI_CONFIRMATION_TTL_SECONDS=300
